  deliverables={{
    heading: "Ce que vous obtenez",
    items: [
      { title: "Un document de correspondance", text: "Chaque champ, de l'ancien système au nouveau, avec chaque décision consignée et approuvée." },
      { title: "Le nettoyage des données", text: "Doublons fusionnés, codes uniformisés, fiches inactives archivées, avant tout chargement." },
