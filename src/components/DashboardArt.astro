---
// Illustrative job-profitability dashboard (sample data, not a client's).
import type { Lang } from "../i18n/routes";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const l =
  lang === "fr"
    ? {
        label: "Illustration d'un tableau de bord de rentabilité par chantier : prévu par rapport au réel pour six chantiers, un chantier en dépassement.",
        title: "Rentabilité par chantier",
        period: "Cette semaine",
        kpis: [["Chantiers actifs", "24"], ["Marge brute", "18,4 %"], ["Bons de travail", "37"]],
        plan: "Prévu",
        actual: "Réel",
        over: "Dépassement",
      }
    : {
        label: "Illustration of a job profitability dashboard: plan versus actual cost for six jobs, with one job over budget.",
        title: "Job profitability",
        period: "This week",
        kpis: [["Active jobs", "24"], ["Gross margin", "18.4%"], ["Open work orders", "37"]],
        plan: "Plan",
        actual: "Actual",
        over: "Over budget",
      };

// Plan vs actual cost for six sample jobs (relative heights).
const jobs = [
  { id: "J-101", plan: 96, actual: 83 },
  { id: "J-102", plan: 77, actual: 72 },
  { id: "J-103", plan: 112, actual: 134 },
  { id: "J-104", plan: 64, actual: 57 },
  { id: "J-105", plan: 88, actual: 79 },
  { id: "J-106", plan: 51, actual: 46 },
];
const base = 318;
---

<svg class="hero-art" viewBox="0 0 480 360" role="img" aria-label={l.label} width="480" height="360">
  <rect x="10" y="14" width="462" height="340" rx="16" fill="#e9e6dd" />
  <rect x="4" y="6" width="462" height="340" rx="16" fill="#ffffff" stroke="#e3e1da" />

  <text x="28" y="42" font-size="15" font-weight="700" fill="#14161a">{l.title}</text>
  <rect x="356" y="26" width="92" height="24" rx="12" fill="#f6f5f1" stroke="#e3e1da" />
  <text x="402" y="42" font-size="11.5" fill="#3d4450" text-anchor="middle">{l.period}</text>

  {
    l.kpis.map(([name, value], i) => (
      <g transform={`translate(${28 + i * 142} 64)`}>
        <rect width="130" height="62" rx="10" fill={i === 2 ? "#fff4d6" : "#f6f5f1"} />
        <text x="12" y="23" font-size="11" fill="#5b6370">{name}</text>
        <text x="12" y="48" font-size="20" font-weight="750" fill="#14161a">{value}</text>
      </g>
    ))
  }

  {[0, 1, 2, 3].map((i) => <line x1="28" x2="448" y1={base - i * 42} y2={base - i * 42} stroke="#efede7" />)}

  {
    jobs.map((job, i) => {
      const x = 42 + i * 70;
      const over = job.actual > job.plan;
      return (
        <g>
          <rect x={x} y={base - job.plan} width="20" height={job.plan} rx="3" fill="#d9d6cc" />
          <rect x={x + 23} y={base - job.actual} width="20" height={job.actual} rx="3" fill={over ? "#fdb913" : "#14161a"} />
          <text x={x + 21} y={base + 18} font-size="10.5" fill="#5b6370" text-anchor="middle">
            {job.id}
          </text>
        </g>
      );
    })
  }

  <g transform="translate(155 152)">
    <rect width="96" height="22" rx="11" fill="#14161a" />
    <text x="48" y="15" font-size="10.5" font-weight="700" fill="#fdb913" text-anchor="middle">▲ {l.over}</text>
  </g>

  <g transform="translate(366 146)" font-size="11" fill="#3d4450">
    <rect width="10" height="10" rx="2" fill="#d9d6cc" />
    <text x="15" y="9">{l.plan}</text>
    <rect y="18" width="10" height="10" rx="2" fill="#14161a" />
    <text x="15" y="27">{l.actual}</text>
  </g>
</svg>
