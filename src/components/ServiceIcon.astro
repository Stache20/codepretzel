---
// Line icons for the four services. Decorative: the card heading carries the meaning.
interface Props {
  name: "reporting" | "migration" | "healthCheck" | "webApps";
}
const { name } = Astro.props;
---

<svg viewBox="0 0 24 24" fill="none" stroke="#14161a" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {
    name === "reporting" && (
      <>
        <path d="M4 20V10M10 20V4M16 20v-7M22 20H2" />
      </>
    )
  }
  {
    name === "migration" && (
      <>
        <ellipse cx="7" cy="5.5" rx="4" ry="2" />
        <path d="M3 5.5v5c0 1.1 1.8 2 4 2s4-.9 4-2v-5" />
        <ellipse cx="17" cy="13.5" rx="4" ry="2" />
        <path d="M13 13.5v5c0 1.1 1.8 2 4 2s4-.9 4-2v-5M11 8.5h4l-1.5-1.5M15 8.5l-1.5 1.5" />
      </>
    )
  }
  {
    name === "healthCheck" && (
      <>
        <path d="M9 4H6a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2h-3" />
        <rect x="9" y="2.5" width="6" height="3.5" rx="1" />
        <path d="m8.5 13 2.5 2.5 4.5-5" />
      </>
    )
  }
  {
    name === "webApps" && (
      <>
        <rect x="2.5" y="4" width="19" height="16" rx="2" />
        <path d="M2.5 8.5h19M6 6.3h.01M8.5 6.3h.01M9 13l-2 2 2 2M15 13l2 2-2 2" />
      </>
    )
  }
</svg>
