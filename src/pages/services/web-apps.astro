---
import ServicePage from "../../layouts/ServicePage.astro";
---

<ServicePage
  lang="en"
  route="webApps"
  title="Custom Web Application Developer in Montreal | WebPretzel"
  description="Client portals, marketplaces, internal tools and business websites built around your data. Custom web application developer in Montreal."
  crumb="Web apps & sites"
  eyebrow="Web apps & sites"
  h1="Custom web applications, built around your data"
  lead="When your data needs a front end (a client portal, a marketplace, an internal tool or a business website), I build that too. As a custom web application developer in Montreal, I start from the data, so what I build fits how your business actually works."
  who={{
    heading: "Who this is for",
    intro: "Businesses that have outgrown spreadsheets and email, or need a website that actually brings in work.",
    items: [
      "Clients or subcontractors who should see their own information online",
      "A spreadsheet-based process that needs to become a proper tool",
      "A marketplace or platform idea that needs to be built properly",
      "A business website that's slow, outdated or invisible in search",
    ],
  }}
  problems={{
    heading: "Problems a custom web application solves",
    items: [
      {
        title: "Processes run on spreadsheets",
        text: "Shared files with broken formulas, version conflicts and no record of who changed what.",
      },
      {
        title: "Calls just to ask for a status",
        text: "Clients phone or email for information that already exists in your system. A portal lets them look it up themselves.",
      },
      {
        title: "Off-the-shelf software that almost fits",
        text: "You pay for features you don't use and work around the ones you're missing.",
      },
      {
        title: "A website that doesn't bring in work",
        text: "It loads slowly, says little about what you do and doesn't show up when people search.",
      },
    ],
  }}
  deliverables={{
    heading: "What I build",
    items: [
      { title: "Client and subcontractor portals", text: "Secure logins where people see their own jobs, documents, statuses and reports." },
      { title: "Internal tools", text: "Forms, workflows and approvals that replace spreadsheets and keep a clean record in your database." },
      { title: "Marketplaces and platforms", text: "Listings, accounts, search, messaging and payments, built to grow." },
      { title: "Business websites", text: "Fast, bilingual and search-friendly, so people find you and understand what you do." },
      { title: "Connections to your data", text: "Apps that read from and write to your existing database and reports, instead of creating another silo." },
      { title: "Hosting and support", text: "Set up properly from day one, with maintenance and updates when you need them." },
    ],
  }}
  steps={{
    heading: "How a web project works",
    items: [
      { title: "Talk", text: "You explain who will use it and what they need to do. I ask about the data behind it." },
      { title: "Scope", text: "I sketch the screens and the data model and write down what the first version includes." },
      { title: "Build", text: "Working versions early and often, so you can click through and give feedback as it takes shape." },
      { title: "Launch and support", text: "Go-live, monitoring, and changes as your business grows." },
    ],
  }}
  faq={{
    heading: "Web apps and sites: common questions",
    items: [
      {
        q: "What technologies do you use?",
        a: "Mainstream, well-supported tools such as React, Node.js, SQL Server and PostgreSQL, hosted on platforms like Netlify or Azure. I choose them for long-term maintainability, not trends.",
      },
      {
        q: "Can the app connect to our existing database or ERP?",
        a: "Yes, that's usually the point. The app can display live data from your existing systems and write back where it's safe to do so.",
      },
      {
        q: "Can the site or app be bilingual?",
        a: "Yes. English and French are built in from the start, which matters for any business in Quebec.",
      },
      {
        q: "Who owns the code?",
        a: "You do. The source code, accounts and documentation are yours.",
      },
      {
        q: "Do you maintain the app after launch?",
        a: "Yes, ongoing support is available. If you'd rather hand it to your own team, I document it so they can take over.",
      },
    ],
  }}
  cta={{
    heading: "Have an app or site in mind?",
    text: "Tell me what you want people to be able to do. In a free 30-minute call we'll work out what a sensible first version looks like.",
  }}
>
  <section class="section section-alt" aria-labelledby="recent">
    <div class="wrap">
      <div class="section-head">
        <h2 id="recent">Recently delivered</h2>
        <p>A few recent projects, described without client names.</p>
      </div>
      <div class="grid grid-2">
        <div class="card">
          <h3>An online marketplace</h3>
          <p>A two-sided marketplace with user accounts, listings, search and a back office for the owner to manage it all.</p>
        </div>
        <div class="card">
          <h3>Business websites</h3>
          <p>Websites for small companies, built to load fast, explain the business clearly and rank in local search.</p>
        </div>
      </div>
    </div>
  </section>
</ServicePage>
